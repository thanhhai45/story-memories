#!/bin/bash -e
# Chạy Kamal bằng Docker image chính thức — không cần cài Ruby trên máy.
# Biến môi trường triển khai được đọc từ .env.deploy (xem .env.deploy.example).
cd "$(dirname "$0")/.."

if [ -f .env.deploy ]; then
  set -a; . ./.env.deploy; set +a
fi

SSH_ARGS=()
if [ "$(uname)" = "Darwin" ]; then
  # Docker Desktop cho macOS chia sẻ ssh-agent qua socket này
  SSH_ARGS=(-v /run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock -e SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock)
elif [ -n "$SSH_AUTH_SOCK" ]; then
  SSH_ARGS=(-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
fi

ENV_ARGS=()
for name in KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE POSTGRES_PASSWORD ANTHROPIC_API_KEY ADMIN_PASSWORD \
            DEPLOY_HOST APP_DOMAIN REGISTRY_USERNAME REGISTRY_SERVER LLM_MODEL ADMIN_USERNAME \
            S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY; do
  [ -n "${!name}" ] && ENV_ARGS+=(-e "$name")
done

TTY_ARGS=(-i)
[ -t 0 ] && TTY_ARGS=(-it)

exec docker run "${TTY_ARGS[@]}" --rm \
  -v "$PWD:/workdir" -w /workdir \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v "$HOME/.ssh:/root/.ssh:ro" \
  "${SSH_ARGS[@]}" "${ENV_ARGS[@]}" \
  ghcr.io/basecamp/kamal:${KAMAL_VERSION:-latest} "$@"
