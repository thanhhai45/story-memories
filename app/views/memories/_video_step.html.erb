<div class="flex items-start gap-4">
  <span class="step-number">3</span>
  <div class="min-w-0 flex-1">
    <h2 class="text-2xl">Video</h2>

    <% if latest_completed_render&.output_video&.attached? %>
      <div class="mt-5">
        <%= video_tag rails_blob_path(latest_completed_render.output_video, disposition: "inline"),
              controls: true, preload: "metadata", playsinline: true, class: "aspect-video w-full rounded-xl bg-ink" %>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <%= link_to "Tải MP4", rails_blob_path(latest_completed_render.output_video, disposition: "attachment"), class: "btn-quiet !py-2", data: { turbo: false } %>
          <span class="text-ink/55">
            <%= [latest_completed_render.video_template&.name, latest_completed_render.duration_label,
                 human_size(latest_completed_render.output_video.byte_size)].compact.join(", ") %>
          </span>
        </div>
      </div>
    <% end %>

    <% unless memory.ready_for_render? %>
      <p class="mt-3 text-sm text-ink/60">Cần ít nhất <%= Memory::MIN_PHOTOS_FOR_VIDEO %> ảnh và một câu chuyện đã lưu để dựng video.</p>
    <% end %>

    <%= form_with url: memory_video_renders_path(memory), scope: :video_render, class: "mt-6 space-y-6",
          data: { controller: "video-render" } do |f| %>
      <fieldset>
        <legend class="field-label">Mẫu video</legend>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
          <% current_template = memory.effective_template %>
          <% templates.each do |template| %>
            <label class="block cursor-pointer rounded-xl border border-ink/15 bg-white p-4" data-video-render-target="option">
              <span class="flex items-center gap-2">
                <%= f.radio_button :video_template_id, template.id, checked: template == current_template,
                      class: "accent-plum", data: { action: "change->video-render#chooseTemplate",
                                                    music: template.suggested_music } %>
                <span class="font-medium"><%= template.name %></span>
              </span>
              <span class="mt-1 block text-sm text-ink/60"><%= template.description %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset>
        <legend class="field-label">Nhạc nền</legend>
        <p class="field-hint">Các bản nhạc được tạo riêng cho ứng dụng nên dùng và chia sẻ thoải mái. Chọn mẫu video sẽ tự gợi ý một bản hợp.</p>
        <div class="mt-2 grid gap-3 sm:grid-cols-3">
          <% MusicLibrary.all.each do |track| %>
            <label class="block cursor-pointer rounded-xl border border-ink/15 bg-white p-4" data-video-render-target="option">
              <span class="flex items-center gap-2">
                <%= f.radio_button :music_track, track.key, checked: track.key == memory.effective_music_track,
                      class: "accent-plum", data: { action: "change->video-render#highlight" } %>
                <span class="font-medium"><%= track.name %></span>
              </span>
              <span class="mt-1 block text-xs text-ink/55"><%= track.genre %> · <%= track.mood_label %></span>
              <audio controls preload="none" src="<%= music_url(track) %>" class="mt-3 h-8 w-full"
                     data-video-render-target="audio" data-action="play->video-render#play"></audio>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="flex flex-wrap items-center gap-3">
        <%= f.submit latest_completed_render ? "Tạo lại video" : "Tạo video", class: "btn-primary",
              disabled: !memory.ready_for_render?, data: { turbo_submits_with: "Đang gửi…" } %>
        <span class="text-sm text-ink/55">Thường mất 1–3 phút. Bạn có thể rời trang, video vẫn được dựng.</span>
      </div>
    <% end %>

    <% if renders.any? %>
      <div class="mt-8 border-t border-ink/10 pt-5">
        <h3 class="font-sans text-sm font-medium text-ink/70">Các lần dựng gần đây</h3>
        <ul class="mt-2 divide-y divide-ink/10 text-sm">
          <% renders.each do |video_render| %>
            <li class="flex items-center justify-between gap-3 py-2.5">
              <%= link_to memory_video_render_path(memory, video_render), class: "link" do %>
                <%= l(video_render.created_at, format: :short) %>
              <% end %>
              <span class="flex items-center gap-3">
                <span class="text-ink/50"><%= video_render.video_template&.name %></span>
                <%= render_status_badge(video_render) %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
