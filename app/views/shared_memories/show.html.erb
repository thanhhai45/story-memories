<% content_for :title, @memory.title %>

<main class="mx-auto flex min-h-screen max-w-4xl flex-col px-5 py-12 sm:py-16">
  <header class="text-center">
    <h1 class="font-display text-4xl leading-tight text-white sm:text-6xl"><%= @story&.title.presence || @memory.title %></h1>
    <% subtitle = @story&.subtitle.presence || @memory.period_label %>
    <% if subtitle %>
      <p class="mt-3 text-white/60"><%= subtitle %></p>
    <% end %>
  </header>

  <div class="mt-10">
    <% if @video_render&.output_video&.attached? %>
      <%= video_tag expiring_blob_path(@video_render.output_video, disposition: :inline),
            controls: true, preload: "metadata", playsinline: true,
            class: "aspect-video w-full rounded-lg bg-black shadow-2xl ring-1 ring-white/10" %>
      <div class="mt-6 flex justify-center">
        <%= link_to "Tải video về máy", expiring_blob_path(@video_render.output_video, disposition: :attachment),
              class: "rounded-full border border-white/25 px-5 py-2.5 text-sm text-white hover:border-white/60", data: { turbo: false } %>
      </div>
    <% else %>
      <div class="flex aspect-video w-full items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10">
        <p class="text-white/60">Video đang được chuẩn bị. Hãy quay lại sau ít phút nhé.</p>
      </div>
    <% end %>
  </div>

  <% if @story&.ending.present? %>
    <p class="mx-auto mt-12 max-w-xl text-center font-display text-xl italic leading-relaxed text-white/80"><%= @story.ending %></p>
  <% end %>

  <footer class="mt-auto pt-16 text-center text-xs text-white/35">Anniversary Memories</footer>
</main>
