<% if notice.present? %>
  <p class="mb-6 rounded-lg border border-plum/20 bg-plum/5 px-4 py-3 text-sm text-plum-deep" role="status"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p class="mb-6 rounded-lg border border-rose/30 bg-rose/5 px-4 py-3 text-sm text-rose" role="alert"><%= alert %></p>
<% end %>
