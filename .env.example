# Dùng cho docker compose (môi trường phát triển). Chép thành .env rồi điền.

# Bật AI viết lời dẫn (để trống = tạo bản nháp từ tâm sự, không gọi AI)
ANTHROPIC_API_KEY=
# Chỉ cần khi API key không gắn với workspace (lỗi "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=
# Model mặc định: claude-sonnet-5-5. Muốn rẻ/nhanh hơn: claude-haiku-5-5
LLM_MODEL=

# Bật Basic Auth cho trang quản trị ngay cả khi chạy local (tùy chọn)
ADMIN_USERNAME=
ADMIN_PASSWORD=

PORT=3000
