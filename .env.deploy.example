# Biến cho Kamal — chép thành .env.deploy (đã được .gitignore) rồi điền.
# bin/kamal tự nạp file này trước khi chạy.

# Máy chủ (Ubuntu có SSH bằng key, user root hoặc user có quyền docker)
DEPLOY_HOST=203.0.113.10
# User/port SSH (mặc định root / 22). User không phải root phải thuộc nhóm docker.
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
# Tên miền đã trỏ A record về DEPLOY_HOST (Kamal tự xin chứng chỉ Let's Encrypt)
APP_DOMAIN=memories.example.com

# Registry chứa image (Docker Hub: để trống REGISTRY_SERVER; GHCR: ghcr.io)
REGISTRY_SERVER=
REGISTRY_USERNAME=your-docker-hub-user
KAMAL_REGISTRY_PASSWORD=dckr_pat_xxx

# Tạo bằng: openssl rand -hex 64
SECRET_KEY_BASE=
# Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=


# AI (tùy chọn)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=
